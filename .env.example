# Read by cmd/api and cmd/migrate. Copy to .env for local runs.
PORT=8080
GIN_MODE=debug

# Host ports published by docker compose. Override when something already holds
# 5432 or 8080 locally; they do not affect a local `make run`.
POSTGRES_PORT=5432
API_PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/restock_priority?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=restock_priority
DB_SSLMODE=disable
